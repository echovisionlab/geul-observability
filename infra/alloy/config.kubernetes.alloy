otelcol.receiver.otlp "default" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		logs    = [otelcol.processor.transform.canonical_logs.input]
		traces  = [otelcol.processor.transform.kratos_trace_sanitizer.input]
		metrics = [otelcol.exporter.otlphttp.mimir.input]
	}
}

otelcol.processor.transform "kratos_trace_sanitizer" {
	error_mode = "propagate"

	trace_statements {
		context    = "span"
		statements = [
			`keep_keys(span.attributes, ["http.request.method", "http.response.status_code", "http.route", "http.method", "http.status_code"]) where resource.attributes["service.name"] == "geul-kratos"`,
		]
	}

	trace_statements {
		context    = "spanevent"
		statements = [
			`keep_keys(spanevent.attributes, ["SelfServiceFlowType", "SelfServiceMethodUsed", "LoginRequestedAAL", "LoginRequestedPrivilegedSession", "SelfServiceSSOProviderUsed"]) where resource.attributes["service.name"] == "geul-kratos" and IsMatch(spanevent.name, "^(Login|Registration|Session)")`,
			`keep_keys(spanevent.attributes, []) where resource.attributes["service.name"] == "geul-kratos" and not IsMatch(spanevent.name, "^(Login|Registration|Session)")`,
		]
	}

	output {
		traces = [otelcol.exporter.otlp.tempo.input]
	}
}

otelcol.processor.transform "canonical_logs" {
	error_mode = "ignore"

	log_statements {
		context    = "resource"
		statements = [
			`set(attributes["service.namespace"], "geul")`,
			`set(attributes["deployment.environment"], "production")`,
		]
	}

	log_statements {
		context    = "log"
		statements = [
			`set(log.attributes["retention_class"], "application") where log.attributes["event"] != nil and log.attributes["outcome"] != nil`,
			`set(log.attributes["retention_class"], "diagnostic") where log.attributes["event"] == nil or log.attributes["outcome"] == nil`,
			`set(log.attributes["message"], log.body)`,
			`set(log.attributes["level"], log.severity_text)`,
			`set(log.body, log.attributes)`,
		]
	}

	output {
		logs = [otelcol.processor.attributes.loki_labels.input]
	}
}

otelcol.processor.attributes "loki_labels" {
	action {
		key    = "exporter"
		action = "upsert"
		value  = "otlp"
	}

	action {
		key    = "loki.resource.labels"
		action = "upsert"
		value  = "service.name,service.namespace,deployment.environment"
	}

	action {
		key    = "loki.attribute.labels"
		action = "upsert"
		value  = "domain,outcome,retention_class,exporter"
	}

	output {
		logs = [otelcol.processor.batch.logs.input]
	}
}

otelcol.processor.batch "logs" {
	output {
		logs = [otelcol.exporter.loki.default.input]
	}
}

otelcol.exporter.loki "default" {
	forward_to = [loki.write.default.receiver]
}

discovery.kubernetes "pods" {
	role = "pod"
}

discovery.relabel "kubernetes_logs" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
		regex         = "(.+)"
		target_label  = "service_name"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_instance"]
		regex         = "(.+)"
		target_label  = "service_name"
	}

	rule {
		replacement  = "production"
		target_label = "deployment_environment"
	}

	rule {
		replacement  = "kubernetes"
		target_label = "exporter"
	}

	rule {
		replacement  = "kubernetes"
		target_label = "platform"
	}

	rule {
		replacement  = "system"
		target_label = "retention_class"
	}

	rule {
		replacement  = "geul"
		target_label = "service_namespace"
	}
}

loki.source.kubernetes "pods" {
	targets    = discovery.relabel.kubernetes_logs.output
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo:4317"

		tls {
			insecure = true
		}
	}
}

otelcol.exporter.otlphttp "mimir" {
	client {
		endpoint = "http://mimir:9009/otlp"
	}
}

prometheus.exporter.postgres "geul" {
	data_source_names          = [sys.env("GEUL_POSTGRES_OBSERVER_DSN")]
	custom_queries_config_path = "/etc/alloy/postgres-queries.yml"
}

prometheus.scrape "postgres" {
	targets         = prometheus.exporter.postgres.geul.targets
	forward_to      = [prometheus.remote_write.mimir.receiver]
	scrape_interval = "30s"
}

prometheus.remote_write "mimir" {
	endpoint {
		url = "http://mimir:9009/api/v1/push"
	}
}

        "label": "Trace service",
        "multi": true,
        "name": "service",
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}, service)"
        },
        "refresh": 2,
        "type": "query"
      },
      {
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".+",
        "includeAll": true,
        "multi": true,
        "name": "environment",
        "label": "Log environment",
        "query": "production,staging,development",
        "type": "custom"
      },
      {
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".+",
        "includeAll": true,
        "multi": true,
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({service_namespace=\"geul\", exporter=\"otlp\", retention_class=~\"application|diagnostic\", deployment_environment=~\"${environment:regex}\"}, service_name)",

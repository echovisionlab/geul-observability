  "editable": true,
  "description": "Geul operational entry point. Use metrics to identify an affected service, then narrow owned application logs by environment, service, domain, outcome, event, or correlation ID. Vendor and one-shot container logs are kept separate.",
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,

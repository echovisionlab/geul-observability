        "includeAll": true,
        "multi": true,
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({service_namespace=\"geul\", exporter=\"otlp\", retention_class=\"application\", deployment_environment=~\"${environment:regex}\", service_name=~\"${application_service:regex}\"}, domain)",
        "label": "Domain",
        "name": "domain",
        "query": "label_values({service_namespace=\"geul\", exporter=\"otlp\", retention_class=\"application\", deployment_environment=~\"${environment:regex}\", service_name=~\"${application_service:regex}\"}, domain)",
        "refresh": 2,
        "type": "query"
      },
      {
        "current": {

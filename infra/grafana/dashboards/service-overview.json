        "label": "Event regex",
        "name": "event",
        "query": ".*",
        "type": "textbox"
      },
      {
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*",
        "includeAll": true,
        "multi": true,
        "datasource": {
          "type": "loki",

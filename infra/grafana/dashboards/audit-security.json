      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "durable-records"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  occurred_at AS \"Time\",\n  CASE action\n    WHEN 'authentication.succeeded' THEN 'Signed in'\n    WHEN 'authentication.failed' THEN 'Sign-in failed'\n    WHEN 'authentication.blocked' THEN 'Sign-in blocked'\n    WHEN 'authorization.denied' THEN 'Access denied'\n    WHEN 'personal_data.accessed' THEN 'Viewed personal data'\n    ELSE initcap(replace(replace(action, '.', ' '), '_', ' '))\n  END AS \"Activity\",\n  action AS \"Exact action\",\n  CASE\n    WHEN actor_kind = 'member' THEN COALESCE(actor_email, actor_member_id::text)\n    WHEN actor_kind = 'system' THEN actor_service\n    ELSE 'anonymous'\n  END AS \"Actor\",\n  COALESCE(target_type, subject_type) AS \"Object type\",\n  COALESCE(target_id, subject_id) AS \"Object ID\",\n  changed_fields::text AS \"Changed fields\",\n  collection_operation AS \"Collection operation\",\n  previous_state AS \"Previous state\",\n  new_state AS \"New state\",\n  authentication_method AS \"Authentication method\",\n  principal_state AS \"Principal state\",\n  provider AS \"Provider\",\n  reason AS \"Reason\",\n  data_category AS \"Data category\",\n  source_ip::text AS \"Source IP\",\n  request_id::text AS \"Request ID\",\n  trace_id AS \"Trace ID\",\n  attributes::text AS \"Technical details\",\n  record_id::text AS \"Record ID\"\nFROM observability.durable_record\nWHERE $__timeFilter(occurred_at)\n  AND record_class IN (${record_class:sqlstring})\n  AND (${action:sqlstring} = '__all__' OR action = ${action:sqlstring})\n  AND (\n    ${email:sqlstring} = ''\n    OR actor_email = lower(${email:sqlstring})\n    OR actor_member_id::text = ${email:sqlstring}\n    OR actor_service = ${email:sqlstring}\n  )\n  AND (\n    ${target_type:sqlstring} = ''\n    OR target_type = ${target_type:sqlstring}\n    OR subject_type = ${target_type:sqlstring}\n  )\n  AND (\n    ${target_id:sqlstring} = ''\n    OR target_id = ${target_id:sqlstring}\n    OR subject_id = ${target_id:sqlstring}\n  )\n  AND (${reason:sqlstring} = '' OR reason = ${reason:sqlstring})\n  AND (${source_ip:sqlstring} = '' OR source_ip::text = ${source_ip:sqlstring})\n  AND (${request_id:sqlstring} = '' OR request_id::text = ${request_id:sqlstring})\n  AND (${trace_id:sqlstring} = '' OR trace_id = ${trace_id:sqlstring})\n  AND (${changed_field:sqlstring} = '' OR changed_fields @> jsonb_build_array(${changed_field:sqlstring}::text))\nORDER BY occurred_at DESC, record_id DESC\nLIMIT 500;",
          "refId": "A"
        }
      ],
      "title": "Investigation Results",
      "type": "table"
    }
  ],

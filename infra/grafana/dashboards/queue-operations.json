    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Queue event rate by service and canonical event. Narrow service, event, outcome, or queue before expanding the time range.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (service_name, event) (rate({service_namespace=\"geul\", deployment_environment=~\"${environment:regex}\", exporter=\"otlp\", retention_class=\"application\", service_name=~\"${service:regex}\", domain=\"queue\", outcome=~\"${outcome:regex}\"} | json event=\"body.event\", queue=\"body.queue\", level=\"body.level\" | event=~`${event:raw}` | queue=~`${queue:raw}` | level=~\"${log_level:regex}\" [$__auto]))",
          "legendFormat": "{{service_name}} {{event}}"
        }
      ],
      "title": "Queue Event Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Most frequent failed queue events grouped by canonical reason and error type.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,

    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Whether Alloy's PostgreSQL exporter can connect and complete its collectors, including the PGMQ query. Zero also covers missing metric data.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {

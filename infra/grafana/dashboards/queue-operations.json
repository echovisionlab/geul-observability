    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "All canonical queue lifecycle events in the selected range.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null

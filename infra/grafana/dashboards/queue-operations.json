      },
      "targets": [
        {
          "expr": "topk(20, sum by (service_name, event, queue, reason, error_code) (count_over_time({service_namespace=\"geul\", deployment_environment=~\"${environment:regex}\", exporter=\"otlp\", retention_class=\"application\", service_name=~\"${service:regex}\", domain=\"queue\", outcome=\"failed\"} | json event=\"body.event\", queue=\"body.queue\", reason=\"body.reason\", error_code=\"body.error_code\" | event=~`${event:raw}` | queue=~`${queue:raw}` [$__range])))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Top Queue Failures",
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",

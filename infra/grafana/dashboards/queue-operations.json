  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["geul", "queue"],
  "templating": {
    "list": [
      {
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "label": "Log environment",
        "multi": true,
        "name": "environment",
        "query": "production,staging,development",
        "type": "custom"
      },
      {
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({service_namespace=\"geul\", exporter=\"otlp\", retention_class=\"application\", deployment_environment=~\"${environment:regex}\", domain=\"queue\"}, service_name)",
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "query": "label_values({service_namespace=\"geul\", exporter=\"otlp\", retention_class=\"application\", deployment_environment=~\"${environment:regex}\", domain=\"queue\"}, service_name)",
        "refresh": 2,
        "type": "query"
      },
      {
        "current": {
          "selected": false,
          "text": "queue\\..*",
          "value": "queue\\..*"
        },
        "label": "Event regex",
        "name": "event",
        "query": "queue\\..*",
        "type": "textbox"
      },
      {

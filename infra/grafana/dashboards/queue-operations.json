      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service_namespace=\"geul\", deployment_environment=~\"${environment:regex}\", exporter=\"otlp\", retention_class=\"application\", service_name=~\"${service:regex}\", domain=\"queue\"} | json event=\"body.event\", queue=\"body.queue\" | event=~`${event:raw}` | queue=~`${queue:raw}` [$__range])) or vector(0)",

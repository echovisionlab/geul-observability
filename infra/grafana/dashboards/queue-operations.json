      },
      "description": "Canonical queue lifecycle logs. Set a known message, command, or correlation ID to follow one operation across services.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "id": 7,
      "options": {
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{service_namespace=\"geul\", deployment_environment=~\"${environment:regex}\", exporter=\"otlp\", retention_class=\"application\", service_name=~\"${service:regex}\", domain=\"queue\", outcome=~\"${outcome:regex}\"} | json event=\"body.event\", queue=\"body.queue\", message=\"body.message\", message_id=\"body.message_id\", command_id=\"body.command_id\", correlation_id=\"body.correlation_id\", level=\"body.level\" | event=~`${event:raw}` | queue=~`${queue:raw}` | level=~\"${log_level:regex}\" | message_id=~`${message_id:raw}` | command_id=~`${command_id:raw}` | correlation_id=~`${correlation_id:raw}` | line_format \"{{.event}} — {{.message}}\"",
          "refId": "A"
        }
      ],
      "title": "Queue Lifecycle Logs",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Queue warnings and errors independent of the selected outcome.",
      "gridPos": {

      "id": 8,
      "options": {
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{service_namespace=\"geul\", deployment_environment=~\"${environment:regex}\", exporter=\"otlp\", retention_class=\"application\", service_name=~\"${service:regex}\", domain=\"queue\"} | json event=\"body.event\", queue=\"body.queue\", message=\"body.message\", level=\"body.level\" | event=~`${event:raw}` | queue=~`${queue:raw}` | level=~\"ERROR|WARN\" | line_format \"{{.event}} — {{.message}}\"",
          "refId": "A"
